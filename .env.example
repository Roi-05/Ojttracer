# Copy to .env.local for local dev; set these in your host's dashboard for production.
NODE_ENV=production
# Supabase -> Project Settings -> Database -> Connection string -> Session pooler
DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Google Apps Script Web App URL (bypasses Render Free SMTP port blocks)
GMAIL_SCRIPT_URL=
# Public URL of the deployed site (used in emails)
APP_URL=https://your-app.onrender.com
# DOCX -> PDF service (Gotenberg), see DEPLOYMENT.md
GOTENBERG_URL=
# Supabase Storage for uploads (Project Settings -> API: Project URL + service_role key)
# SERVER-SIDE ONLY. Never expose the service_role key in frontend code.
# If left empty, files are saved to server/uploads (local dev).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

